#!/usr/bin/env bash
# Image lane chain runner. One stage per invocation, so every output gets read
# before the next stage spends on it.
#
#   ./run-chain.sh <run-folder> <stage>
#   stages: 2 3 4a 4b 4c 4d 5
#
# Brand paths come from VARIABLES.md — change them there and here together.
set -euo pipefail

R="${1:?run folder, e.g. runs/2026-08-19-<brand>-thai-secret}"
S="${2:?stage: 2 3 4a 4b 4c 4d 5}"
CM="$(cd "$(dirname "$0")/.." && pwd)"          # content-machine
IL="$CM/image-lane"
AW="$HOME/Projects/ai-workspace"
V1="$AW/integration-desk/inbound/damon-cowork-<brand>-brand/v1"
MODEL="${MODEL:-gemini-3.1-pro-preview}"

O="$IL/$R/out"
P="$IL/prompts"
V="$IL/$R/vars"

avatar="$V1/avatars/susan-core.md"
language_bank="$V1/language/customer-language.md"
objection_bank="$V1/language/objection-bank.md"
product_file="$V1/products/body-scrub.md"
offer_file="$V1/hub/offer-bank.md"
identity_anchors="$HOME/devel/daemn/brands/<brand>/identity-anchors.md"
hook_ledger="$HOME/devel/daemn/brands/<brand>/hook-ledger.md"

teardown="$O/01-teardown-ad-02.md"
spec="$O/04-stage2-replication-spec.md"
inject="$O/05-stage3-injection.md"
plan="$O/06-stage4a-placement.md"
hooks="$O/07-stage4b-hooks.md"
support="$O/08-stage4c-support.md"
frame="$O/09-stage4d-offer.md"
sheet="$O/10-stage5-generation-spec.md"

run() { python3 "$HOME/devel/daemn/video-teardown-machine/tools/gemini_text.py" --model "$MODEL" "$@"; }

case "$S" in
2)  run --prompt-file "$P/stage2-image-replication-v1-damon.md" \
        --var teardown_record="$teardown" --out "$spec" ;;
3)  run --prompt-file "$P/stage3-image-injection-v1-damon.md" \
        --var teardown_record="$teardown" --var replication_spec="$spec" \
        --var brand_name="$V/brand_name.md" --var avatar="$avatar" \
        --var product_file="$product_file" --var offer_file="$offer_file" \
        --var language_bank="$language_bank" \
        --var identity_anchors="$identity_anchors" \
        --var production_route="$V/production_route.md" --out "$inject" ;;
4a) run --prompt-file "$P/stage4a-image-placement-v1-damon.md" \
        --var baseline_injection="$inject" --var teardown_record="$teardown" \
        --var replication_spec="$spec" \
        --var product_file="$product_file" --var objection_bank="$objection_bank" \
        --out "$plan" ;;
4b) run --prompt-file "$P/stage4b-image-hook-v1-damon.md" \
        --var replication_spec="$spec" --var placement_plan="$plan" \
        --var baseline_injection="$inject" --var teardown_record="$teardown" \
        --var language_bank="$language_bank" \
        --var avatar="$avatar" --var hook_ledger="$hook_ledger" \
        --var identity_anchors="$identity_anchors" --out "$hooks" ;;
4c) run --prompt-file "$P/stage4c-image-support-v1-damon.md" \
        --var replication_spec="$spec" --var placement_plan="$plan" \
        --var hook_set="$hooks" --var baseline_injection="$inject" \
        --var teardown_record="$teardown" --var product_file="$product_file" \
        --var language_bank="$language_bank" --var offer_file="$offer_file" \
        --out "$support" ;;
4d) run --prompt-file "$P/stage4d-image-offer-v1-damon.md" \
        --var expanded_script="$support" --var placement_plan="$plan" \
        --var baseline_injection="$inject" --var replication_spec="$spec" \
        --var product_file="$product_file" --var objection_bank="$objection_bank" \
        --var offer_file="$offer_file" --out "$frame" ;;
5)  cat "$frame" "$hooks" > "$O/.stage4_outputs.md"
    run --prompt-file "$P/stage5-image-generation-v2-damon.md" \
        --var stage4_outputs="$O/.stage4_outputs.md" \
        --var replication_spec="$spec" --var teardown_record="$teardown" \
        --var product_file="$product_file" --var offer_file="$offer_file" \
        --var language_bank="$language_bank" \
        --var identity_anchors="$identity_anchors" --out "$sheet" ;;
*)  echo "unknown stage: $S" >&2; exit 1 ;;
esac
