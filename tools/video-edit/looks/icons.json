{
 "_readme": "Icons, emoji, stickers and drawn elements the edit may set on top. A row's `set` says where it comes from and under what licence. `drawn` rows are pure SVG/CSS made by the edit — nothing to fetch. `icon`, `emoji` and `sticker` rows are open-licence SVG files that must be LOCAL for a render to be the same every time: `python3 machine/icons.py` lists what it would fetch (nothing is downloaded until someone runs `install`); until then the edit draws the row's `fallback_char` as plain text and the gate WARNS by name. The sheet's `icons` layer names a row: [{scene, icon, zone, at_words, size, text, value}]. Only the owner signs a row approved.",
 "asset": "video",
 "bank": "icon",
 "updated": "2026-09-23",
 "fetch_dir": "looks/icons",
 "sizes": {
  "s": 96,
  "m": 160,
  "l": 260
 },
 "animations": {
  "in": {
   "pop": "scales up past full size and settles",
   "draw": "the stroke draws itself on",
   "wipe": "wipes on left to right",
   "fill": "fills to its value",
   "slap": "lands big and tilted, snaps flat, a small shake",
   "spin-in": "turns in from -90° while scaling up",
   "swing": "swings down from its string hole",
   "tap": "presses in, ripple out",
   "glide": "glides in on a curve and clicks",
   "twinkle": "each sparkle flashes on in turn",
   "burst": "two cannons fire from the lower corners, the pieces tumble and fall (canvas-confetti physics, seek-safe)"
  },
  "out": {
   "shrink": "shrinks away twice as fast as it came in",
   "fade-fall": "each piece fades as it falls"
  }
 },
