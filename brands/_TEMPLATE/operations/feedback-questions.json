{
 "_what": "Starter feedback questions, one set per stage, with the page's look and each stage's email. These are the starting shape only: before anything goes live, language_pass.py rewrites every question, tap option and email from the brand's own customer words (its language bank), and the look comes from the brand's design system.",
 "brand": "brand-name",
 "label": "<Brand>",
 "form_version": "template",
 "default_stage": "new-customer",
 "areas": [
  "marketing",
  "product",
  "operations",
  "customer-service",
  "customer-experience",
  "website"
 ],
 "look": {
  "logo_alt": "<Brand>",
  "font_body": "system-ui, sans-serif",
  "font_head": "system-ui, sans-serif",
  "head_transform": "none",
  "tokens": {
   "band": "#111111",
   "band_ink": "#FFFFFF",
   "ground": "#FFFFFF",
   "card": "#FFFFFF",
   "ink": "#111111",
   "muted": "#6B6B6B",
   "line": "#111111",
   "accent": "#111111",
   "accent_2": "#444444",
   "cta": "#111111",
   "cta_ink": "#FFFFFF",
   "cta_line": "#111111",
   "picked": "#111111",
   "picked_ink": "#FFFFFF",
   "radius": "8px",
   "chip_radius": "999px"
  },
  "source": "neutral starter look: replace every token with the brand's design system (brands/<brand>/brand-identity/web-tokens.md)",
  "logo": "assets/images/logo.svg"
 },
 "copy": {
  "start": "Let's go",
  "next": "Next",
  "back": "Back",
  "skip": "Skip",
