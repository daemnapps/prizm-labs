# Prizm — your keys.
# The setup page (components/onboarding) fills this in with you; or copy this file to .env and fill it by hand.
# .env is ignored by git: it stays on your machine. Never paste a key into a chat, an issue or any other file.
# Fill only what you use. Every key below is read by at least one tool; the group says how much you need it.

# --- Needed to make ads --------------------------------------------------------
# Gemini: reads videos and images in every teardown, labels language, tags creative (used by 40+ tools). Get it: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI: pictures, casting and the judging steps. Get it: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Higgsfield: where pictures and clips are made (image and video production, briefs, email pictures). Get it: https://higgsfield.ai (account > API keys)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# ElevenLabs: transcripts and voices. Get it: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Apify: pulls posts, comments and pages from Instagram, TikTok and YouTube for swipes and research. Get it: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# --- Your accounts ---------------------------------------------------------------
# Meta: reads your ad account and files ads for your approval (never goes live by itself). Get it: Meta Business Settings > System users > Generate token
PRIZM_META_TOKEN=
# Google Drive (optional): path to a service-account JSON file, so tools can file to your Drive. Get it: https://console.cloud.google.com/iam-admin/serviceaccounts (create key > JSON), then share your Drive folder with that account
GDRIVE_SA_KEY=
# Your own ads and orders database (optional): Postgres connection URL, read by the copywriter, research and media buying. Get it: your database provider's connection settings
DATABASE_URL=

# --- One tool each (optional) -------------------------------------------------
# TrendTrack: competitor ads and trends for swipes. Get it: https://trendtrack.io (account > API)
TRENDTRACK_API_KEY=
# Kalodata: TikTok Shop products and creators. Get it: https://www.kalodata.com (account > API)
KALODATA_API_KEY=
# AdPlexity: paid-ad swipe capture. Get it: your AdPlexity account > API
ADPLEXITY_API_KEY=
# AudD: names the music in a swiped video. Get it: https://dashboard.audd.io
AUDD_API_TOKEN=
# fal.ai: a few video and training steps that still run there. Get it: https://fal.ai/dashboard/keys
FAL_KEY=
# BytePlus: one direct video model in video production. Get it: https://console.byteplus.com (ModelArk > API keys)
BYTEPLUS_API_KEY=
# PostHog: your site's visits and recordings for the page teardown. Get it: https://app.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# --- Phone posting (being built; optional) --------------------------------------
# GeeLark: posts to phone accounts. Use the token, OR the app id + key pair. Get it: GeeLark > Settings > API
GEELARK_API_TOKEN=
GEELARK_APP_ID=
GEELARK_API_KEY=
# A proxy for one GeeLark phone (name it yourself, e.g. PROXY_DE_1, and pass that name to the tool). Format: socks5://user:pass@host:port
PROXY_DE_1=

# --- Running Claude without you (optional) ---------------------------------------
# Claude long-life login token: lets scheduled Claude steps run without you signing in. Get it: run `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Anthropic API key: runs the Claude steps on an API key instead of your Claude login. Get it: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Backups (optional) ---------------------------------------------------------
# A second account, used by itself when the first runs out of credit. Same places as above.
GEMINI_API_KEY_PERSONAL=
APIFY_TOKEN_PERSONAL=

# --- Old names (do not add) ----------------------------------------------------
# SUPABASE_DB_URL is the old name of DATABASE_URL; HF_API_KEY_ID / HF_API_KEY_SECRET are the old names of the
# Higgsfield pair. Tools still accept the old names, so nothing breaks, but only the names above go in a new .env.

# --- Per-brand keys (email production only) --------------------------------------
# Named in your brand's own files; the usual names are:
#   KLAVIYO_<BRAND>_KEY                 Klaviyo private API key (Klaviyo > Settings > API keys)
#   LOOP_<BRAND>_KEY                    Loop Subscriptions API key (Loop admin > API)
#   <BRAND>_NEXTCOMMERCE_STORE          your Next Commerce store subdomain
#   <BRAND>_NEXTCOMMERCE_ACCESS_TOKEN   Next Commerce admin API token
#   SHOPIFY_<BRAND>_CLIENT_ID / SHOPIFY_<BRAND>_APP   Shopify custom app credentials (Shopify admin > Apps > Develop apps)
