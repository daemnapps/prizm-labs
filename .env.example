# Prizm Lab — your keys.
# Copy this file to .env (same folder) and fill in only the keys for the tools
# you use. .env is ignored by git: it stays on your machine and is never
# committed. Never paste a key into a chat, an issue, or any other file.
# Names only below — no values. Leave a line blank if you don't use that tool.

# --- AI models ---------------------------------------------------------------
# Gemini: reads videos and images in the teardowns, labels language, tags creative. Get it: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI: picture generation and some writing/judging steps. Get it: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic API key (optional): runs the Claude stages on an API key instead of your Claude login. Get it: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Claude long-life login token (optional): lets scheduled Claude stages run without re-login. Get it: run `claude setup-token` in Claude Code
CLAUDE_CODE_OAUTH_TOKEN=

# --- Voice, sound, video, images ---------------------------------------------
# ElevenLabs: transcripts (speech-to-text) and voices. Get it: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# fal.ai: video, image and music generation in video-production / email-production. Get it: https://fal.ai/dashboard/keys
FAL_KEY=
# BytePlus (optional): one of video-production's direct video models. Get it: https://console.byteplus.com (ModelArk > API keys)
BYTEPLUS_API_KEY=
# Higgsfield (optional): image generation in image-production. Get it: https://higgsfield.ai (account > API keys)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# AudD (optional): identifies the music in a swiped video. Get it: https://dashboard.audd.io
AUDD_API_TOKEN=

# --- Pulling posts and ads ---------------------------------------------------
# Apify: pulls creators' posts, comments and hashtags from Instagram/TikTok/YouTube. Get it: https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Apify second account (optional): used automatically when the first runs out of monthly credit. Same place as above.
APIFY_TOKEN_PERSONAL=
# AdPlexity (optional): paid-ad swipe capture. Get it: your AdPlexity account > API
ADPLEXITY_API_KEY=

# --- Google Drive ------------------------------------------------------------
# Path to a Google service-account JSON file (the path, not the file's contents): lets tools save Docs and files to your Drive. Get it: https://console.cloud.google.com/iam-admin/serviceaccounts (create key > JSON), then share your Drive folder with that account
GDRIVE_SA_KEY=

# --- Your own data (optional, advanced) --------------------------------------
# Postgres connection URL for your own ads/orders warehouse (copywriter, research-gatherer, meta-strategy). Get it: your database provider's connection settings
DATABASE_URL=
# Meta system-user token: uploads ads and reads your ad account. Get it: Meta Business Settings > System users > Generate token
PRIZM_META_TOKEN=

# --- Per-brand keys (email-production; only if you use it) --------------------
# The name of each is set in your brand's files; the usual names are:
#   KLAVIYO_<BRAND>_KEY                 Klaviyo private API key (Klaviyo > Settings > API keys)
#   LOOP_<BRAND>_KEY                    Loop Subscriptions API key (Loop admin > API)
#   <BRAND>_NEXTCOMMERCE_STORE          your Next Commerce store subdomain
#   <BRAND>_NEXTCOMMERCE_ACCESS_TOKEN   Next Commerce admin API token
#   SHOPIFY_<BRAND>_CLIENT_ID / SHOPIFY_<BRAND>_APP   Shopify custom app credentials (Shopify admin > Apps > Develop apps)
