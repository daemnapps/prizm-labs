# keys — never
.env
*.env
.gemini.env
*.key
credentials.json

# your work, not the toolkit
brands/*/
!brands/_TEMPLATE/
runs/
out/
output/
*.db

# media — too big for git
*.mp4
*.mov
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.zip
# …except what the site actually delivers. The blanket rule above keeps swiped
# media and stray archives out; a download offered on the page has to ship.
!docs/downloads/*.zip
# …and what the page shows. Same reasoning: swiped media stays out, the
# examples the site actually displays have to ship.
!docs/media/*.mp4
!docs/media/*.jpg
!docs/media/**/*.jpg
!docs/media/field/*.jpg
# the swipe teardowns' pictures, generated by publish_swipes.py (each well under 2 MB)
!docs/swipes/*/img/*.jpg
# every brief kit's pictures — a kit page with unshipped pictures shows broken
# images to the clippers (found 2026-09-23: a third of the DOUXDS kit was 404)
!docs/briefs/*/img/*.jpg
# the AI Slop page: the piece itself, its poster and its frames (what the page shows)
!docs/ai-slop/*.mp4
!docs/ai-slop/*.jpg
# …and its making-of media (sheets, personas, outfits, stem excerpts)
!docs/ai-slop/m/*.jpg
!docs/ai-slop/m/*.mp4
!docs/ai-slop/m/*.mp3
!docs/ai-slop/m/*.png
# the Carousel page (was ai-slop; moved 2026-09-27)
!docs/carousel/*.mp4
!docs/carousel/*.jpg
!docs/carousel/m/*.jpg
!docs/carousel/m/*.mp4
!docs/carousel/m/*.mp3
!docs/carousel/m/*.png
# the site's own icons
!docs/*.png
!docs/media/*.png

# noise
.DS_Store
__pycache__/
*.pyc
.venv/
venv/
node_modules/
# …and My Feeds' pictures (360px covers + frame strips, written by the team
# workspace's feedsexport.py; size-checked under 40 MB before they land).
!docs/feeds/data/thumbs/*.webp
# the ad factory page: its pictures and opening clips (each under 2 MB)
!docs/three-doctors/m/*.mp4
!docs/three-doctors/m/*.jpg
